---
interface Props {
    interactive?: boolean;
}

const { interactive = false } = Astro.props;
---

<header class="site-header">
    {interactive ? (
        <button id="swag-button" class="site-header-action"><span class="header-title" >U WANNA STEAL MY SWAG</span></button>
    ) : <span class="header-title">U WANNA STEAL MY SWAG</span>}
</header>

<script>
    
    document.getElementById('swag-button')?.addEventListener('click', () => {
        window.location.href = '12.html';
    });
</script>
