---
interface Props {
    interactive?: boolean;
}

const { interactive = false } = Astro.props;
---

<header>
    {interactive ? (
        <button id="swag-button" class="site-header-action">U WANNA STEAL MY SWAG</button>
    ) : 'U WANNA STEAL MY SWAG'}
</header>

<script>
    document.getElementById('swag-button')?.addEventListener('click', () => {
        window.location.href = '12.html';
    });
</script>
