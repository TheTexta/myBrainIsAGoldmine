<dialog id="post-image-viewer" class="image-viewer" aria-label="Enlarged image" data-ui>
    <figure class="viewer-stage" data-viewer-stage>
        <p class="viewer-feedback sr-only" role="status" data-viewer-feedback></p>
    </figure>
    <button class="viewer-close crt-control" type="button" aria-label="Close image" data-viewer-close>
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 5 19 19M19 5 5 19" />
        </svg>
    </button>
</dialog>

<script>
    const dialog = document.querySelector<HTMLDialogElement>('#post-image-viewer')!;
    const stage = dialog.querySelector<HTMLElement>('[data-viewer-stage]')!;
    const feedback = dialog.querySelector<HTMLElement>('[data-viewer-feedback]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-viewer-close]')!;
    let trigger: HTMLAnchorElement | null = null;
    let image: HTMLImageElement | null = null;
    let previousOverflow = '';
    let scrollPosition = { left: 0, top: 0 };

    const fitSource = () => {
        const thumbnail = trigger?.querySelector('img');
        if (!thumbnail || !image) return;
        const ratio = Number(thumbnail.getAttribute('width')) / Number(thumbnail.getAttribute('height')) || thumbnail.naturalWidth / thumbnail.naturalHeight || 1;
        image.sizes = `${Math.max(1, Math.ceil(Math.min(stage.clientWidth, stage.clientHeight * ratio)))}px`;
    };
    document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-post-image]') : null;
        if (!target || dialog.open || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || typeof dialog.showModal !== 'function') return;
        event.preventDefault();
        trigger = target;
        const thumbnail = target.querySelector('img')!;
        scrollPosition = { left: window.scrollX, top: window.scrollY };
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
        feedback.textContent = 'Loading image.';
        feedback.hidden = false;
        feedback.classList.add('sr-only');
        const selected = new window.Image();
        image = selected;
        selected.className = 'viewer-image';
        selected.alt = thumbnail.alt;
        selected.decoding = 'async';
        selected.hidden = true;
        if (import.meta.env.DEV && thumbnail.dataset.imageComponent) selected.dataset.imageComponent = thumbnail.dataset.imageComponent;
        selected.onload = () => { if (image === selected) { selected.hidden = false; feedback.hidden = true; } };
        selected.onerror = () => {
            if (image !== selected) return;
            feedback.textContent = 'Image could not be loaded.';
            feedback.classList.remove('sr-only');
        };
        stage.append(selected);
        fitSource();
        selected.srcset = target.dataset.viewerSrcset ?? '';
        selected.src = target.href;
        close.focus();
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Tab') { event.preventDefault(); close.focus(); }
    });
    stage.addEventListener('click', (event) => { if (event.target === stage) dialog.close(); });
    dialog.addEventListener('close', () => {
        document.body.style.overflow = previousOverflow;
        image?.remove(); image = null;
        trigger?.focus({ preventScroll: true });
        window.scrollTo(scrollPosition.left, scrollPosition.top);
    });
    window.addEventListener('resize', () => { if (dialog.open) fitSource(); });
</script>
