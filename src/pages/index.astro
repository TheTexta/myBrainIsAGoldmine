---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CatToggle from '../components/CatToggle.astro';
import { loadFeed, type FeedEntry } from '../lib/feed';
import { responsiveImages } from '../lib/images/public';
import { accessiblePostMarkup } from '../lib/content-accessibility';
import ImageViewer from '../components/ImageViewer.astro';

export const prerender = false;
let groups: FeedEntry[][] = [];
let unavailable = false;
try {
    groups = await loadFeed();
    await Promise.all(groups.flat().map(async (entry) => { entry.html = await responsiveImages(accessiblePostMarkup(entry.html, entry.title), Astro.url.origin, entry.id); }));
}
catch { unavailable = true; Astro.response.status = 503; }
Astro.response.headers.set('Cache-Control', 'no-store');
---

<SiteLayout title="U wanna steal my swag 101">
    <SiteHeader interactive />
    <div class="site-container feed-container">
        <CatToggle />
        {unavailable ? (
            <div class="content tinos-regular"><h1>Back soon.</h1><p>The writing is temporarily unavailable. Please try again in a moment.</p></div>
        ) : groups.map((entries) => (
            <div class="content tinos-regular">
                {entries.map((entry) => (
                    <>
                        {!entry.legacy && <h1 class="title tinos-regular">{entry.title}</h1>}
                        <Fragment set:html={entry.html} />
                    </>
                ))}
            </div>
        ))}
    </div>
    <SiteFooter />
    <ImageViewer />
    <script is:inline src="https://videopress.com/videopress-iframe.js"></script>
</SiteLayout>
