---
import AdminApp from '../components/admin/AdminApp';
import { publicConfig } from '../lib/server';
import '../styles/admin.css';

export const prerender = false;
const config = publicConfig();
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Publishing — My brain is a goldmine</title>
    <link rel="icon" href="/assets/favicon/favicon-96x96.png" />
</head>
<body>
    {config ? <AdminApp client:only="react" url={config.url} anonKey={config.key} /> : <main class="setup-notice">
        <h1 class="admin-heading">Publishing setup required</h1><p class="admin-copy">The editor is not connected to Supabase yet. Follow the repository setup instructions to configure storage and grant this site's editorial access.</p><a class="admin-link" href="/">Back to the site</a>
    </main>}
</body>
</html>
