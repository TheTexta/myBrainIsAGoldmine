---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<SiteLayout title="U wanna steal my swag 101">
    <!-- Header -->
    <SiteHeader />

    <!-- Content Container -->
    <div class="container" style="margin-top: 10vh;">
        <div class="padding"></div>
        <div class="main">
            <p class="text tinos-regular">
                Hi bitches im mallory U eat ass so much ass im the biggest ass eater of them all.
            </p>
            <div>
                <img src="mirror_base.png" alt="">
                <img src="mirror_screen.png" class="img-stack" alt="" id="mirror-screen">
            </div>

            <a href="12.html">ENTER</a>
        </div>
        <div class="padding" style="transform: scaleX(-100%);"></div>
    </div>
    <SiteFooter />
</SiteLayout>

<script>
    const mirror = document.getElementById('mirror-screen');

    if (mirror) {
        let i = 0;
        window.setInterval(() => {
            const value = 1 + Math.abs(Math.sin(i)) / 4;
            mirror.style.filter = `contrast(${value}) brightness(${value})`;
            i += Math.PI / 5;
            if (i > 2 * Math.PI) {
                i = 0;
            }
        }, 10);
    }
</script>
