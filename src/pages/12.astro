---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image, getImage } from 'astro:assets';
import { collageFront, collageBack } from '../lib/images/sources';
import { responsiveWidths } from '../lib/images/settings';
import { artworkBackground } from '../lib/images/public';

const options = { widths: responsiveWidths(collageFront.width), sizes: '45vh', format: 'webp' as const, quality: 85 };
const [front, back, background] = await Promise.all([
    getImage({ src: collageFront, ...options }), getImage({ src: collageBack, ...options }),
    artworkBackground(collageBack, { small: [480, 960], medium: [960, 1920], large: [1280, 2316] }),
]);
---

<SiteLayout title="12" bodyClass="artwork-12" bodyStyle={background}>
    <div class="artwork-fog"></div>
    <div class="fun-container">
        <Image src={collageFront} {...options} loading="eager" fetchpriority="high" alt="" data-original-src="12-1.png"
            data-front-src={front.src} data-front-srcset={front.srcSet.attribute}
            data-back-src={back.src} data-back-srcset={back.srcSet.attribute} />
        <a href="index.html" class="back-button grayscale">bye!!!!!!!!!!!!!!</a>
    </div>

</SiteLayout>

<script>
    const backButton = document.querySelector(".back-button");
    const img = document.querySelector<HTMLImageElement>(".fun-container img");
    if (backButton && img) {
        const swap = (front: boolean) => {
            img.srcset = (front ? img.dataset.frontSrcset : img.dataset.backSrcset)!;
            img.src = (front ? img.dataset.frontSrc : img.dataset.backSrc)!;
            img.dataset.originalSrc = front ? '12-1.png' : '12-2.png';
        };
        backButton.addEventListener("mouseover", () => {
            swap(true);
        });
        backButton.addEventListener("mouseout", () => {
            swap(false);
        });
    }
</script>
