{
  "name": "my-brain-is-a-goldmine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:graphics": "playwright test --config=playwright.graphics.config.ts",
    "test:unit": "vitest run",
    "test:images:dev": "PUBLIC_SUPABASE_URL= PUBLIC_SUPABASE_ANON_KEY= node scripts/check-dev-images.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:visual": "PUBLIC_SUPABASE_URL= PUBLIC_SUPABASE_ANON_KEY= npm run build && node scripts/verify-legacy-visuals.mjs",
    "test:vercel": "VERCEL=1 astro build && node scripts/check-vercel-output.mjs",
    "test": "npm run check && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@astrojs/vercel": "11.0.17",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@mantine/core": "9.0.2",
    "@mantine/hooks": "9.0.2",
    "@supabase/supabase-js": "2.118.0",
    "astro": "7.4.4",
    "parse5": "8.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": { "zod": "$zod" },
    "@vercel/routing-utils": { "path-to-regexp": "6.3.0" }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
