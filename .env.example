# Public Supabase project URL and anon/publishable key only. No service-role key.
# Set the public HTTPS origin at build time for trusted Host/Origin validation.
SITE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used solely to mark byte-verified uploads ready after editor checks.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, site-scoped credentials for a private R2 bucket. Never PUBLIC_*.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
